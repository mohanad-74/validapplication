rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() { return firestore.get(/databases/(default)/documents/artifacts/validapp-default/public/data/users/$(request.auth.uid)); }
    function canUpload() { return signedIn() && profile().data.active == true && profile().data.role in ['Creator','Administrator']; }
    match /studies/{studyId}/{fileName} {
      allow read: if signedIn();
      allow write: if canUpload() && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType in ['application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.ms-excel','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'];
      allow delete: if signedIn() && profile().data.role == 'Administrator';
    }
  }
}
