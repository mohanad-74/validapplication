// Global handler for returning records
window.returnRecordToCreator = async (recordId) => {
    const comment = prompt("Enter reason for returning record to creator:");
    
    if (comment === null) return; // User canceled prompt
    if (!comment.trim()) {
        alert('A return reason comment is mandatory.');
        return;
    }

    // Convert both IDs to strings to prevent string/number lookup failures
    const rec = records.find(r => String(r.id) === String(recordId));

    if (rec) {
        rec.status = (typeof STATUS !== 'undefined' && STATUS.RETURNED) ? STATUS.RETURNED : 'Returned for Revision';
        rec.returnComment = comment.trim();
        rec.returnedBy = currentUser?.username || 'Unknown';
        rec.returnedAt = new Date().toISOString();

        // Save records using available storage helper
        if (typeof saveRecords === 'function') {
            await saveRecords();
        } else if (typeof saveToLocalStorage === 'function') {
            saveToLocalStorage();
        }

        renderTable();

        if (typeof showMessage === 'function') {
            showMessage('Success', 'Record returned to creator with comment.', 'success');
        } else {
            alert('Record returned to creator with comment.');
        }
    } else {
        console.error('Record not found for ID:', recordId);
    }
};
// Global handler to open edit modal for returned records
window.openEditModal = (recordId) => {
    try {
        const record = records.find(r => String(r.id) === String(recordId));
        if (!record) {
            alert('Record not found!');
            return;
        }

        // 1. Show feedback prompt
        if (record.returnComment) {
            alert(`Return Feedback from ${record.returnedBy || 'Reviewer'}:\n\n"${record.returnComment}"`);
        }

        // 2. Trigger native modal trigger via "+ Add Record" button
        const addBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Add Record'));
        if (addBtn) {
            addBtn.click();
        }

        // Unhide all parent containers of the record form
        const formEl = document.getElementById('recordForm') || (typeof ui !== 'undefined' && ui?.recordForm);
        if (formEl) {
            let current = formEl;
            while (current && current !== document.body) {
                current.classList.remove('hidden');
                if (window.getComputedStyle(current).display === 'none') {
                    current.style.display = 'flex';
                }
                current = current.parentElement;
            }
        }

        // 3. Populate form fields with returned record data
        const setVal = (id, val) => {
            const el = document.getElementById(id);
            if (el) el.value = val !== undefined && val !== null ? val : '';
        };

        setVal('recordId', record.id);
        setVal('productName', record.productName);
        setVal('studyCategory', record.studyCategory);
        setVal('productType', record.productType);
        setVal('studyDate', record.date || record.studyDate);
        setVal('stage', record.stage);
        setVal('studyStatus', record.status);
        setVal('version', record.version);
        setVal('scale', record.scale);
        setVal('reason', record.reason);
        setVal('notes', record.notes);

    } catch (err) {
        console.error('Error in openEditModal:', err);
        alert('Error opening edit form: ' + err.message);
    }
};
