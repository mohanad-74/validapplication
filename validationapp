                reason: document.getElementById('reason').value,
              notes: document.getElementById('notes').value,
createdBy: id ? (records.find(r => r.id === id)?.createdBy || currentUser.username) : currentUser.username
};
          

            if (id) {
                // Edit
                const record = records.find(r => r.id === id);
                if (record) {
                    const updatedRecord = { ...record, ...data };
                    if(db) await setDoc(getDocRef('records', id), updatedRecord);
                    logAction('Edited Data', data.productName, `Updated Stage: ${data.stage}, Ver: ${data.version}, Status: ${data.status}.`, updatedRecord);
                    showMessage('Success', 'Record updated successfully.', 'success');
                }
            } else {
                // Add
                const newRecord = {
                    id: generateId(),
                    ...data,
                    createdBy: currentUser.username,
                    createdAt: new Date().toISOString()
                };
                if (db) {
                    await setDoc(getDocRef('records', newRecord.id), newRecord);
                } else {
                    records.unshift(newRecord);
                }
                
                logAction('Added Record', data.productName, `Added as ${data.stage}, Ver: ${data.version}.`, newRecord);
                showMessage('Success', 'New record added successfully.', 'success');
            }

            ui.recordModal.classList.remove('active');
            if(!db) renderTable(); 
        });

      window.processAction = (id, newStatus, isReject = false) => {
    const record = records.find(r => r.id === id);
    if (!record) return;

    const activeUser = currentUser?.username || currentUser?.name || 'Unknown User';
    const targetStatus = newStatus || (isReject ? 'Rejected' : 'Reviewed');

    let actionName = 'Action';
    if (isReject) actionName = 'Rejected';
    else if (targetStatus === 'Reviewed' || targetStatus === STATUS?.REVIEWED) actionName = 'Reviewed';
    else if (targetStatus === 'Approved' || targetStatus === STATUS?.APPROVED) actionName = 'Approved';

    const confirmMsg = isReject 
        ? `Are you sure you want to REJECT ${record.productName}?`
        : `Are you sure you want to mark ${record.productName} as ${targetStatus}?`;

    const handleUpdate = async (reason = '') => {
        try {
            const updates = { 
                status: targetStatus,
                updatedAt: new Date().toISOString() 
            };

            if (isReject) {
                updates.rejectedBy = activeUser;
                if (reason) updates.rejectionReason = reason;
            } else if (targetStatus === 'Reviewed' || targetStatus === STATUS?.REVIEWED) {
                updates.reviewedBy = activeUser;
            } else if (targetStatus === 'Approved' || targetStatus === STATUS?.APPROVED) {
                updates.approvedBy = activeUser;
            }

            // Update UI state immediately
            Object.assign(record, updates);
            if (typeof renderTable === 'function') renderTable();

            // Persist to Firebase if connected
            if (typeof db !== 'undefined' && db && typeof updateDoc === 'function' && typeof getDocRef === 'function') {
                await updateDoc(getDocRef('records', id), updates);
            }

            if (typeof logAction === 'function') logAction(`${actionName} Record`, record.productName, `Status: ${targetStatus}`, record);
            if (typeof showMessage === 'function') showMessage('Success', `Record updated to ${targetStatus}.`, 'success');

        } catch (err) {
            console.error('Error during action execution:', err);
            alert('Action failed: ' + (err.message || err));
        }
    };

    if (typeof showConfirm === 'function') {
        showConfirm(`Confirm ${actionName}`, confirmMsg, isReject, (reason) => handleUpdate(reason));
    } else {
        if (confirm(confirmMsg)) handleUpdate();
    }
};
        window.editRecord = (id) => {
            const record = records.find(r => r.id === id);
            if (!record) return;

            document.getElementById('modalTitle').textContent = 'Edit Validation Record';
            document.getElementById('recordId').value = record.id;
            document.getElementById('productName').value = record.productName;
            document.getElementById('studyCategory').value = record.studyCategory;
            document.getElementById('productType').value = record.productType;
            document.getElementById('studyDate').value = record.date;
            document.getElementById('stage').value = record.stage;
            document.getElementById('studyStatus').value = record.status;
            document.getElementById('version').value = record.version;
            document.getElementById('scale').value = record.scale;
            document.getElementById('reason').value = record.reason;
            document.getElementById('notes').value = record.notes || '';

            ui.recordModal.classList.add('active');
        };

        document.getElementById('userForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const newU = document.getElementById('newUsername').value;
            const newP = document.getElementById('newPassword').value;
            const newR = document.getElementById('newRole').value;

            if (USERS.some(u => u.username === newU)) {
                showMessage('Error', 'Username already exists.', 'error');
                return;
            }

            const newUser = { username: newU, password: newP, role: newR };
            if (db) {
                await setDoc(getDocRef('users', newU), newUser);
            } else {
                USERS.push(newUser);
                renderUserList();
            }
            document.getElementById('userForm').reset();
            showMessage('Success', 'User added successfully.', 'success');
        });

        window.deleteUser = (index) => {
            const userToDelete = USERS[index];
            showConfirm('Delete User', `Are you sure you want to delete ${userToDelete.username}?`, false, async () => {
                if (db) {
                    await deleteDoc(getDocRef('users', userToDelete.username));
                } else {
                    USERS.splice(index, 1);
                    renderUserList();
                }
                showMessage('Success', 'User deleted.', 'success');
            });
        };
        window.toggleDelegation = function() {
    let currentState = localStorage.getItem('isDelegationActive') === 'true';
    let newState = !currentState;
    
    localStorage.setItem('isDelegationActive', newState);
    if (typeof isDelegationActive !== 'undefined') {
        isDelegationActive = newState;
    }

    window.updateDelegationUI();

    if (typeof renderTable === 'function') {
        renderTable();
    }
};

window.updateDelegationUI = function() {
    const btn = document.getElementById('delegationBtn');
    if (!btn) return;

    const isActive = localStorage.getItem('isDelegationActive') === 'true';
    if (isActive) {
        btn.textContent = 'ON';
        btn.className = 'px-3 py-1 text-xs font-bold rounded text-white bg-green-600 hover:bg-green-700 cursor-pointer';
    } else {
        btn.textContent = 'OFF';
        btn.className = 'px-3 py-1 text-xs font-bold rounded text-white bg-red-600 hover:bg-red-700 cursor-pointer';
    }
};

document.addEventListener('DOMContentLoaded', () => {
    window.updateDelegationUI();
});
    </script>
