<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ValidApp - Validation Study Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- EmailJS Library -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1e40af',
                        secondary: '#3b82f6',
                        accent: '#10b981',
                        dark: '#1f2937',
                        light: '#f3f4f6'
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; }
        .modal { display: none; }
        .modal.active { display: flex; }
        .fade-in { animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        
        /* Custom Scrollbar for tables */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #c1c1c1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #a8a8a8; }
    </style>
</head>
<body class="text-gray-800 h-screen flex flex-col overflow-hidden">

    <nav class="bg-primary text-white shadow-lg p-4 sticky top-0 z-50 flex-shrink-0">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3">
                <i class="fas fa-flask text-2xl"></i>
                <h1 class="text-2xl font-bold tracking-wider">ValidApp</h1>
            </div>
            <div id="userInfo" class="hidden items-center gap-4">
                <span class="bg-blue-800 px-3 py-1 rounded-full text-sm font-semibold border border-blue-400">
                    <i class="fas fa-user-circle mr-1"></i> <span id="currentUserDisplay"></span> (<span id="currentUserRole"></span>)
                </span>
                <button id="userManagementBtn" class="hidden hover:bg-blue-700 px-3 py-1 rounded transition duration-200">
                    <i class="fas fa-users-cog mr-1"></i> Users
                </button>
                <button id="auditTrailBtn" class="hidden hover:bg-blue-700 px-3 py-1 rounded transition duration-200">
                    <i class="fas fa-history mr-1"></i> Audit Trail
                </button>
                <button id="logoutBtn" class="bg-red-500 hover:bg-red-600 px-4 py-1.5 rounded font-semibold transition duration-200 shadow">
                    <i class="fas fa-sign-out-alt mr-1"></i> Logout
                </button>
            </div>
        </div>
    </nav>

    <main class="flex-grow container mx-auto p-4 relative flex flex-col h-full overflow-hidden">
        
        <div id="loginSection" class="max-w-md mx-auto mt-20 bg-white p-8 rounded-xl shadow-2xl border border-gray-100 fade-in flex-shrink-0">
            <div class="text-center mb-8">
                <div class="inline-block bg-blue-100 p-4 rounded-full mb-4">
                    <i class="fas fa-shield-alt text-4xl text-primary"></i>
                </div>
                <h2 class="text-2xl font-bold text-gray-800">System Login</h2>
                <p class="text-gray-500 text-sm mt-1">Please enter your credentials to continue</p>
            </div>
            
            <form id="loginForm" class="space-y-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fas fa-user text-gray-400"></i>
                        </div>
                        <input type="text" id="username" class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition" required placeholder="Username">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fas fa-lock text-gray-400"></i>
                        </div>
                        <input type="password" id="password" class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition" required placeholder="••••••••">
                    </div>
                </div>
                <div id="loginError" class="text-red-500 text-sm hidden font-medium text-center bg-red-50 p-2 rounded">Invalid username or password.</div>
                <button type="submit" class="w-full bg-primary hover:bg-blue-800 text-white font-bold py-2.5 px-4 rounded-lg transition duration-200 shadow-md">
                    Sign In
                </button>
            </form>
        </div>

        <div id="dashboardSection" class="hidden fade-in flex-col h-full overflow-hidden">
            
            <!-- Dashboard Tabs & Header -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4 mt-2 gap-4 flex-shrink-0">
                <div class="flex bg-gray-200 p-1 rounded-lg overflow-x-auto w-full md:w-auto">
                    <button id="tabProcess" class="tab-btn active bg-white text-primary shadow-sm px-4 py-2 rounded-md font-semibold transition-all whitespace-nowrap">Process Validation</button>
                    <button id="tabHoldTime" class="tab-btn text-gray-600 hover:text-gray-900 px-4 py-2 rounded-md font-semibold transition-all whitespace-nowrap">Hold Time Studies</button>
                    <button id="tabCleaning" class="tab-btn text-gray-600 hover:text-gray-900 px-4 py-2 rounded-md font-semibold transition-all whitespace-nowrap">Cleaning Validation</button>
                </div>
                <button id="addRecordBtn" class="hidden bg-accent hover:bg-green-600 text-white px-5 py-2 rounded-lg font-semibold shadow transition duration-200 whitespace-nowrap">
                    <i class="fas fa-plus mr-2"></i> Add Record
                </button>
            </div>

            <!-- Dashboard Filters & Search -->
            <div class="bg-white p-4 rounded-t-xl shadow-sm border border-gray-200 border-b-0 flex flex-wrap gap-4 items-end flex-shrink-0">
                <div class="flex-grow min-w-[200px]">
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Search Product / API</label>
                    <div class="relative">
                        <i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
                        <input type="text" id="searchInput" class="w-full pl-9 pr-3 py-2 border border-gray-300 rounded-md focus:ring-primary focus:border-primary text-sm" placeholder="Search by name...">
                    </div>
                </div>
                
                <div class="w-full md:w-auto min-w-[150px]">
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Study Stage</label>
                    <select id="filterStage" class="w-full p-2 border border-gray-300 rounded-md text-sm focus:ring-primary">
                        <option value="All">All Stages</option>
                        <option value="Raw">Raw</option>
                        <option value="Bulk">Bulk</option>
                        <option value="Finished Product">Finished Product</option>
                        <option value="Cleaning Validation">Cleaning Validation</option>
                        <option value="CHT">CHT</option>
                        <option value="DHT">DHT</option>
                        <option value="Campaign Length">Campaign Length</option>
                    </select>
                </div>

                <div class="w-full md:w-auto min-w-[150px]">
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Status</label>
                    <select id="filterStatus" class="w-full p-2 border border-gray-300 rounded-md text-sm focus:ring-primary">
                        <option value="All">All Statuses</option>
                        <option value="Draft">Draft</option>
                        <option value="Pending Review">Pending Review</option>
                        <option value="Reviewed">Reviewed</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                </div>

                <div class="w-full md:w-auto min-w-[150px]">
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Scale</label>
                    <select id="filterScale" class="w-full p-2 border border-gray-300 rounded-md text-sm focus:ring-primary">
                        <option value="All">All Scales</option>
                        <option value="Lab Scale">Lab Scale</option>
                        <option value="Pilot Scale">Pilot Scale</option>
                        <option value="Commercial Scale">Commercial</option>
                    </select>
                </div>
                
                <div class="w-full md:w-auto">
                    <button id="clearFiltersBtn" class="px-4 py-2 text-gray-500 hover:text-gray-800 hover:bg-gray-100 rounded-md transition text-sm font-medium">
                        Clear Filters
                    </button>
                </div>
            </div>

            <!-- Data Table -->
            <div class="bg-white rounded-b-xl shadow-md border border-gray-200 flex-grow overflow-hidden flex flex-col relative">
                <div class="overflow-auto flex-grow h-full">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Product / API Name</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Type</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Date & Stage</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Scale & Ver</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Reason / Notes</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
                                <th class="px-4 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="dataTableBody" class="bg-white divide-y divide-gray-200 text-sm">
                            <!-- Table rows populated dynamically -->
                        </tbody>
                    </table>
                </div>
                <!-- Empty State -->
                <div id="emptyState" class="hidden absolute inset-0 flex flex-col items-center justify-center bg-white z-20">
                    <i class="fas fa-search text-5xl text-gray-300 mb-4"></i>
                    <p class="text-gray-500 text-lg">No records match your criteria.</p>
                </div>
            </div>
        </div>
    </main>

    <div id="recordModal" class="modal fixed inset-0 bg-gray-900 bg-opacity-60 z-50 items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl overflow-hidden flex flex-col max-h-[95vh]">
            <div class="bg-primary text-white p-4 flex justify-between items-center flex-shrink-0">
                <h3 id="modalTitle" class="text-xl font-bold">Add Validation Record</h3>
                <button class="close-modal text-white hover:text-gray-200 transition">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            <div class="p-6 overflow-y-auto flex-grow">
                <form id="recordForm" class="space-y-4">
                    <input type="hidden" id="recordId">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Product / API Name *</label>
                            <input type="text" id="productName" class="w-full p-2 border border-gray-300 rounded-md focus:ring-primary focus:border-primary" required>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Study Category *</label>
                            <select id="studyCategory" class="w-full p-2 border border-gray-300 rounded-md focus:ring-primary focus:border-primary" required>
                                <option value="Process Validation">Process Validation</option>
                                <option value="Hold Time Study">Hold Time Study</option>
                                <option value="Cleaning Validation">Cleaning Validation</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Product Type *</label>
                            <select id="productType" class="w-full p-2 border border-gray-300 rounded-md focus:ring-primary focus:border-primary" required>
                                <option value="Finished Product">Finished Product</option>
                                <option value="Bulk Product">Bulk Product</option>
                                <option value="API">API</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Study Date *</label>
                            <input type="date" id="studyDate" class="w-full p-2 border border-gray-300 rounded-md focus:ring-primary focus:border-primary" required>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Stage *</label>
                            <select id="stage" class="w-full p-2 border border-gray-300 rounded-md focus:ring-primary focus:border-primary" required>
                                <option value="Raw">Raw</option>
                                <option value="Bulk">Bulk</option>
                                <option value="Finished Product">Finished Product</option>
                                <option value="Cleaning Validation">Cleaning Validation</option>
                                <option value="CHT">CHT</option>
                                <option value="DHT">DHT</option>
                                <option value="Campaign Length">Campaign Length</option>
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Study Status *</label>
                            <select id="studyStatus" class="w-full p-2 border border-gray-300 rounded-md focus:ring-primary focus:border-primary" required>
                                <option value="Draft">Draft</option>
                                <option value="Pending Review">Pending Review</option>
                                <option value="Reviewed">Reviewed</option>
                                <option value="Approved">Approved</option>
                                <option value="Rejected">Rejected</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Version *</label>
                            <input type="text" id="version" class="w-full p-2 border border-gray-300 rounded-md focus:ring-primary focus:border-primary" required placeholder="e.g., v1.0">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Scale *</label>
                            <select id="scale" class="w-full p-2 border border-gray-300 rounded-md focus:ring-primary focus:border-primary" required>
                                <option value="Lab Scale">Lab Scale</option>
                                <option value="Pilot Scale">Pilot Scale</option>
                                <option value="Commercial Scale">Commercial Scale</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Reason for Validation / Study *</label>
                        <textarea id="reason" rows="2" class="w-full p-2 border border-gray-300 rounded-md focus:ring-primary focus:border-primary" required placeholder="Why is this study being conducted?"></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Additional Notes (Any)</label>
                        <textarea id="notes" rows="2" class="w-full p-2 border border-gray-300 rounded-md focus:ring-primary focus:border-primary" placeholder="Optional comments..."></textarea>
                    </div>

                    <div class="pt-4 flex justify-end gap-3 border-t mt-6">
                        <button type="button" class="close-modal px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 transition">Cancel</button>
                        <button type="submit" class="px-4 py-2 bg-primary text-white rounded-md hover:bg-blue-800 transition font-medium">Save Record</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="userModal" class="modal fixed inset-0 bg-gray-900 bg-opacity-60 z-50 items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl flex flex-col max-h-[90vh]">
            <div class="bg-dark text-white p-4 flex justify-between items-center rounded-t-xl flex-shrink-0">
               <h3 class="text-xl font-bold"><i class="fas fa-users-cog mr-2"></i>User Management</h3>

<!-- DELEGATION CONTROL SWITCH -->
<div class="flex items-center gap-2 bg-gray-100 p-2 rounded border">
    <span class="text-xs font-semibold text-gray-700">Deputy QA Delegation:</span>
    <button id="delegationBtn" type="button" onclick="toggleDelegation()" class="px-3 py-1 text-xs font-bold rounded text-white bg-red-600 hover:bg-red-700 cursor-pointer">
        OFF
    </button>
</div>
                <button class="close-user-modal text-white hover:text-gray-300 transition">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            <div class="p-4 bg-gray-50 border-b">
                <form id="userForm" class="flex flex-wrap items-end gap-3">
                    <div class="flex-grow min-w-[150px]">
                        <label class="block text-xs font-medium text-gray-700 mb-1">Username *</label>
                        <input type="text" id="newUsername" class="w-full p-2 border border-gray-300 rounded text-sm" required>
                    </div>
                    <div class="flex-grow min-w-[150px]">
                        <label class="block text-xs font-medium text-gray-700 mb-1">Password *</label>
                        <input type="password" id="newPassword" class="w-full p-2 border border-gray-300 rounded text-sm" required>
                    </div>
                    <div class="flex-grow min-w-[150px]">
                        <label class="block text-xs font-medium text-gray-700 mb-1">Privilege Role *</label>
                        <select id="newRole" class="w-full p-2 border border-gray-300 rounded text-sm" required>
                            <option value="Administrator">Administrator (Add/Edit)</option>
                            <option value="Section Head">Section Head (Review)</option>
                            <option value="QA Manager">QA Manager (Approve)</option>
                            <option value="Deputy QA Manager">Deputy QA Manager</option>
                        </select>
                    </div>
                    <div>
                        <button type="submit" class="bg-accent hover:bg-green-600 text-white px-4 py-2 rounded font-semibold text-sm h-[38px]">Add User</button>
                    </div>
                </form>
            </div>
            <div class="overflow-auto flex-grow p-0">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-100 sticky top-0">
                        <tr>
                            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Username</th>
                            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Role</th>
                            <th class="px-4 py-2 text-center text-xs font-semibold text-gray-600 uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody" class="bg-white divide-y divide-gray-200 text-sm">
                        <!-- User list populated dynamically -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="auditModal" class="modal fixed inset-0 bg-gray-900 bg-opacity-60 z-50 items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-5xl flex flex-col h-[85vh]">
            <div class="bg-dark text-white p-4 flex justify-between items-center rounded-t-xl flex-shrink-0">
                <h3 class="text-xl font-bold"><i class="fas fa-list-alt mr-2"></i>System Audit Trail</h3>
                <button class="close-audit text-white hover:text-gray-300 transition">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            <div class="p-0 overflow-hidden flex-grow flex flex-col">
                <div class="overflow-auto flex-grow">
                    <table class="min-w-full divide-y divide-gray-200 relative">
                        <thead class="bg-gray-100 sticky top-0 z-10 shadow-sm">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Timestamp</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">User / Role</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Action</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Product</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Audit Details</th>
                            </tr>
                        </thead>
                        <tbody id="auditTableBody" class="bg-white divide-y divide-gray-200 text-sm">
                            <!-- Audit logs go here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Message Box Modal -->
    <div id="messageModal" class="modal fixed inset-0 bg-gray-900 bg-opacity-60 z-[60] items-center justify-center p-4">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-sm overflow-hidden text-center fade-in">
            <div id="messageIcon" class="pt-6 pb-2">
                <i class="fas fa-info-circle text-4xl text-blue-500"></i>
            </div>
            <h3 id="messageTitle" class="text-xl font-bold text-gray-800 px-6">Information</h3>
            <p id="messageText" class="text-gray-600 px-6 py-4">This is a message.</p>
            <div class="bg-gray-50 px-6 py-3 flex justify-center">
                <button id="closeMessageBtn" class="bg-primary hover:bg-blue-700 text-white font-bold py-2 px-8 rounded-lg transition">OK</button>
            </div>
        </div>
    </div>

    <!-- Confirm Box Modal -->
    <div id="confirmModal" class="modal fixed inset-0 bg-gray-900 bg-opacity-60 z-[60] items-center justify-center p-4">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-sm overflow-hidden text-center fade-in">
            <div class="pt-6 pb-2">
                <i class="fas fa-question-circle text-4xl text-yellow-500"></i>
            </div>
            <h3 id="confirmTitle" class="text-xl font-bold text-gray-800 px-6">Confirm Action</h3>
            <p id="confirmText" class="text-gray-600 px-6 py-4">Are you sure?</p>
            
            <div id="rejectReasonDiv" class="hidden px-6 pb-4">
                <label class="block text-left text-sm font-medium text-gray-700 mb-1">Reason for Rejection *</label>
                <textarea id="rejectReasonInput" rows="2" class="w-full p-2 border border-gray-300 rounded focus:ring-red-500 focus:border-red-500 text-sm" placeholder="Please specify why this is being rejected..."></textarea>
            </div>

            <div class="bg-gray-50 px-6 py-3 flex justify-center gap-3">
                <button id="cancelConfirmBtn" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-6 rounded-lg transition">Cancel</button>
                <button id="acceptConfirmBtn" class="bg-primary hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg transition">Yes, Proceed</button>
            </div>
        </div>
    </div>

